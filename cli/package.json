{
  "name": "onrails",
  "version": "0.5.2",
  "description": "Install and update onRails in your project: agent rules, skills, guardrails and stack packs for Claude Code and Codex.",
  "keywords": [
    "onrails",
    "claude-code",
    "codex",
    "ai-agents",
    "agents",
    "agents-md",
    "skills",
    "workflow",
    "developer-tools",
    "cli",
    "tracer-bullet",
    "stack-pack",
    "tanstack-start"
  ],
  "author": "Jay Smigen",
  "license": "MIT",
  "homepage": "https://github.com/jsmigendevelopment/onRails#readme",
  "bugs": {
    "url": "https://github.com/jsmigendevelopment/onRails/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jsmigendevelopment/onRails.git",
    "directory": "cli"
  },
  "type": "module",
  "bin": {
    "onrails": "bin/cli.mjs"
  },
  "files": [
    "bin",
    "src",
    "kit"
  ],
  "scripts": {
    "bundle": "node scripts/bundle.mjs",
    "bundle:check": "node scripts/bundle.mjs --check",
    "prepack": "node scripts/bundle.mjs",
    "pack:check": "node scripts/pack-check.mjs",
    "versions:check": "node scripts/versions.mjs --check",
    "release:bump": "node scripts/versions.mjs",
    "test": "node --test \"test/*.test.mjs\""
  },
  "engines": {
    "node": ">=22"
  }
}
