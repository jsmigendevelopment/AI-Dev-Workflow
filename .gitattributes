# Copies the kit's scripts write (sync-skills.mjs, the CLI bundle, npm-readme.mjs). pr-size.mjs, the size rule the
# local gate's pr-rules.mjs uses, doesn't count them toward a pull request's 1,000-line limit.
.claude/skills/** linguist-generated
plugin/** linguist-generated
cli/README.md linguist-generated
# People edit these two by hand (versions.mjs bumps them), and no script writes them, so they count.
plugin/.claude-plugin/plugin.json -linguist-generated
plugin/.codex-plugin/plugin.json -linguist-generated
# Two branches that each add a line under the same Unreleased heading would conflict on every merge of main.
# Union keeps both sides' lines (#362). Git's own merge uses it; GitHub's merge button doesn't.
CHANGELOG.md merge=union
