{
  "rules": [
    { "id": "@secretlint/secretlint-rule-preset-recommend" },
    {
      "id": "@secretlint/secretlint-rule-pattern",
      "options": {
        "patterns": [
          {
            "name": "JWT (an id token or access token)",
            "patterns": ["/eyJ[A-Za-z0-9_-]{10,}\\.eyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}/"]
          },
          {
            "name": "Google API key",
            "patterns": ["/AIza[0-9A-Za-z_-]{35}/"]
          },
          {
            "name": "Password or client secret assigned a quoted value",
            "patterns": ["/(?:password|passwd|client_secret)[\"']?\\s*[:=]\\s*[\"'][^\"'\\s]{8,}[\"']/i"]
          }
        ]
      }
    }
  ]
}
