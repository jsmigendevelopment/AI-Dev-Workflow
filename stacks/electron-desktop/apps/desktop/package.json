{
  "name": "@app/desktop",
  "productName": "my-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A desktop app made from the onRails Electron starter.",
  "main": ".vite/build/main.cjs",
  "scripts": {
    "start": "electron-forge start",
    "build": "electron-forge package && node scripts/verify-fuses.ts && node scripts/smoke.ts",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.main.json && tsc -p tsconfig.preload.json && tsc -p tsconfig.renderer.json",
    "test:e2e": "node scripts/e2e.ts"
  },
  "dependencies": {
    "@app/contract": "workspace:*",
    "@app/engine": "workspace:*",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.108.3",
    "@tanstack/react-router": "1.170.46",
    "clsx": "2.1.1",
    "lucide-react": "1.72.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.1",
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-squirrel": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@electron-forge/plugin-fuses": "8.0.1",
    "@electron-forge/plugin-vite": "8.0.1",
    "@electron-forge/shared-types": "8.0.1",
    "@electron/fuses": "2.1.3",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.5.0",
    "tailwindcss": "4.3.5",
    "vite": "8.3.8"
  }
}
