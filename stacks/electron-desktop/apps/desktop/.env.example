# Where the data folder is; empty means my-app in your user folder · get it: any folder path; tests and the smoke start set it · scope: local,test · secret: no
APP_DATA_DIR=
# Build-time only: e2e packages the e2e flavour into out-e2e/ (inspect fuse on, never released); anything else builds the release flavour · get it: set by pnpm test:e2e, don't set it by hand · scope: test · secret: no
APP_BUILD=
