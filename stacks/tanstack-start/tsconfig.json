{
  // A solution file: it compiles nothing itself. Each file belongs to one of the two projects
  // below, which is how editors and type-aware ESLint (projectService) find the right settings.
  // `pnpm typecheck` runs both. The paths are repeated here for tools that read this file only
  // (shadcn, the import resolver).
  "files": [],
  "references": [{ "path": "./tsconfig.app.json" }, { "path": "./tsconfig.node.json" }],
  "compilerOptions": { "paths": { "@/*": ["./src/*"] } }
}
