{
  // Tests, e2e, scripts and config files: these run in Node, so they get Node types.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node", "vite/client"],
    // Node runs scripts/*.ts directly (type stripping), which needs explicit .ts extensions.
    "allowImportingTsExtensions": true
  },
  "include": ["src", "e2e", "scripts", "worker-configuration.d.ts", "*.config.ts"],
  "exclude": []
}
