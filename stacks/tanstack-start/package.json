{
  "name": "app",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "pnpm cf-typegen && eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "wrangler types -c wrangler.jsonc && tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:visual": "node scripts/test-visual.ts",
    "test:deployed": "playwright test --project=desktop --project=phone e2e/smoke.spec.ts e2e/a11y.spec.ts e2e/api.spec.ts",
    "test:coming-soon": "playwright test --project=coming-soon --project=coming-soon-phone",
    "check": "pnpm lint && pnpm typecheck && pnpm knip && pnpm dupes && pnpm check:migrations && pnpm test && pnpm build",
    "check:lowmem": "pnpm lint && pnpm typecheck && pnpm knip && pnpm dupes && pnpm check:migrations && vitest run --maxWorkers=1 && pnpm build",
    "knip": "knip",
    "dupes": "jscpd",
    "check:migrations": "node scripts/check-migrations.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local -c wrangler.jsonc",
    "routes:generate": "node scripts/generate/routes.ts",
    "new:module": "node scripts/generate/new-module.ts",
    "new:route": "node scripts/generate/new-route.ts",
    "new:section": "node scripts/generate/new-section.ts",
    "new:component": "node scripts/generate/new-component.ts",
    "new:table": "node scripts/generate/new-table.ts",
    "setup:cloudflare": "node scripts/setup-cloudflare.mjs",
    "connect": "node scripts/connect.mjs",
    "cf-typegen": "wrangler types -c wrangler.jsonc",
    "check:budgets": "node scripts/budgets/check-budgets.ts",
    "check:merge": "node scripts/check-merge.ts",
    "pr:rules": "node scripts/pr/check.ts",
    "deploy:preview": "node scripts/deploy.ts preview",
    "deploy:test": "node scripts/deploy.ts test",
    "deploy:production": "node scripts/deploy.ts production",
    "check:licenses": "node scripts/check-licenses.ts",
    "lhci": "node -e \"require('fs').rmSync('.lighthouseci',{recursive:true,force:true})\" && pnpm dlx @lhci/cli@0.16.0 autorun --config=lighthouserc.cjs",
    "icons": "node scripts/generate-icons.ts"
  },
  "dependencies": {
    "@clerk/tanstack-react-start": "1.7.19",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.108.3",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "jose": "6.2.17",
    "lucide-react": "1.77.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@clerk/backend": "3.31.4",
    "@cloudflare/vite-plugin": "1.70.1",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/router-generator": "1.168.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.15.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-better-tailwindcss": "4.10.0",
    "eslint-plugin-boundaries": "7.4.4",
    "eslint-plugin-check-file": "3.3.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "globals": "17.14.0",
    "jscpd": "5.4.2",
    "knip": "6.44.1",
    "lefthook": "2.2.2",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "wrangler": "4.164.0"
  }
}
