{
  "path": ["src", "scripts", "e2e"],
  "format": ["typescript", "tsx", "javascript"],
  "ignore": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/routeTree.gen.ts",
    "src/components/ui/**",
    "scripts/generate/templates/**"
  ],
  "minLines": 6,
  "minTokens": 60,
  "threshold": 3,
  "reporters": ["console"],
  "gitignore": true,
  "noSymlinks": true
}
