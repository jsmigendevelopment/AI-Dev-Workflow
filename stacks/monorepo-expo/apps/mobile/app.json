{
  "expo": {
    "name": "App",
    "slug": "app",
    "scheme": "app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.example.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.example.app"
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "plugins": ["expo-router", "expo-secure-store", "@clerk/expo"],
    "experiments": {
      "autolinkingModuleResolution": true
    }
  }
}
